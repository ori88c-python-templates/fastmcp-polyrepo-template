# Copy to .env before `docker compose up`. The app reads it too.
# .env is git-ignored; this file is not.
#
# These values match the local Compose stack in compose.yaml. They are working
# local credentials, not placeholders to invent.
#
# Variable names follow the nested config path, joined by "__":
# REDIS__HOST maps to AppConfig.redis.HOST.

# Deployment environment: local | dev | staging | prod
ENV=local

# --- Server -----------------------------------------------------------------
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
# Streamable HTTP endpoint. Stateless: no session id, any replica can answer.
SERVER__MCP_PATH=/mcp
# One stateless request may stream progress as SSE. Set false for one JSON body.
SERVER__ENABLE_SSE_STREAM_RESPONSE=true

# --- Logger -----------------------------------------------------------------
# Minimum severity to emit: debug | info | warning | error | critical
# Note: "debug" is rejected when ENV=prod.
LOGGER__MIN_LOG_LEVEL=debug
# Structured uvicorn access lines (context="uvicorn.access"). Default true.
# Set false to emit no access logs at all (not unstructured text either).
LOGGER__ENABLE_UVICORN_ACCESS_LOGS=true

# --- Redis ------------------------------------------------------------------
# Host run talks to Compose on 127.0.0.1 (not "localhost") so Windows does not
# stall on IPv6 while Docker Desktop publishes IPv4 only. Inside a container
# network, use the service name (redis) instead.
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__DB=0
REDIS__USE_TLS=false
# Leave unset for the unauthenticated local Redis. An empty value is an empty
# password, which is not the same thing — do not uncomment this line.
# REDIS__PASSWORD=
# Connect and command timeouts in seconds. Default 5 if unset. Values below 1
# are rejected.
# REDIS__CONNECT_TIMEOUT_SECONDS=5
# REDIS__COMMAND_TIMEOUT_SECONDS=5

# --- Prometheus -------------------------------------------------------------
# Gzip /metrics when the client sends Accept-Encoding: gzip. Default false
# (CPU vs bandwidth; the library prefers leaving this off).
# PROMETHEUS__SHOULD_GZIP=false
